AIRFLOW_IMAGE_NAME=apache/airflow:3.1.7
AIRFLOW_UID=50000
# Metadatabase
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://svc_airflow:<MOT_DE_PASSE>@postgres:5432/airflow
# Celery
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://svc_airflow:<MOT_DE_PASSE>@postgres:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
# Web UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=<MOT_DE_PASSE>
# Security
AIRFLOW__CORE__FERNET_KEY=<GENERER_AVEC_python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AIRFLOW__CORE__LOAD_EXAMPLES=false
# DAG Bundles
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name":"my-git-bundle","classpath":"airflow.providers.git.bundles.git.GitDagBundle","kwargs":{"tracking_ref":"main","git_conn_id":"my_git_conn","subdir":"dags"}},{"name":"dags-folder","classpath":"airflow.dag_processing.bundles.local.LocalDagBundle","kwargs":{}}]
_PIP_ADDITIONAL_REQUIREMENTS=pandas psycopg2-binary sqlalchemy requests dbt-core dbt-postgres dbt-snowflake apache-airflow-providers-snowflake snowflake-connector-python
